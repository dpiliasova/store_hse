erDiagram
    dim_customers {
        int customer_id PK
        text city
        text acquisition_channel
        int first_confirmed_order_id
        timestamp first_confirmed_at
        bigint confirmed_orders_count
        numeric confirmed_revenue
        boolean is_buyer
    }

    dim_products {
        int product_id PK
        text product_name
        text category_name
        text parent_category_name
        text root_category_name
    }

    dim_dates {
        date date_day PK
        int date_year
        int date_month
        int day_of_week
        boolean is_weekend
    }

    fct_orders {
        int order_id PK
        int customer_id FK
        date order_date FK
        numeric order_amount
        bigint items_count
        boolean is_confirmed
    }

    fct_order_items {
        text order_item_id PK
        int order_id FK
        int customer_id FK
        int product_id FK
        date order_date FK
        int quantity
        numeric line_amount
        boolean is_confirmed
    }

